<mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;PK = clave primaria · FK = clave foránea · PK/FK = subtipo · UQ = valor único&lt;br&gt;1 ── N = uno a muchos · 0..1 = opcional · △ = herencia (tabla hija → tabla base)&lt;br&gt;El signo ? indica que la columna admite NULL." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#334155;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1770" width="660" height="100" as="geometry" /></mxCell>
<mxCell id="indices" value="&lt;b&gt;Índices y restricciones principales&lt;/b&gt;&lt;br&gt;• UX_Facturas_Cita: índice único filtrado (CitaId IS NOT NULL) → una factura por cita.&lt;br&gt;• IX_Citas_Veterinario_Fecha e IX_Citas_Mascota_Fecha → agenda y detección de choques.&lt;br&gt;• IX_Facturas_Cliente_Fecha, IX_DetallesFactura_Factura → consultas de cobro.&lt;br&gt;• CK_Facturas_Pago_Coherente → una factura pagada exige método y fecha de pago.&lt;br&gt;• UNIQUE en Documento, Numero, Codigo, NumeroColegiatura y correos de catálogo." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#334155;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1580" y="1390" width="760" height="180" as="geometry" /></mxCell>
<mxCell id="fisico_nota" value="Modelo físico · SQL Server 2022. GUID con NEWSEQUENTIALID(), NVARCHAR para texto, DECIMAL(12,2) para dinero y DATETIME2(0) para marcas de tiempo. Los totales se calculan en vistas." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#334155;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1580" y="1650" width="760" height="70" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
