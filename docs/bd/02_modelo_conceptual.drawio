<mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;PK = clave primaria · FK = clave foránea · PK/FK = subtipo · UQ = valor único&lt;br&gt;1 ── N = uno a muchos · 0..1 = opcional · △ = herencia (tabla hija → tabla base)&lt;br&gt;El signo ? indica que la columna admite NULL." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#334155;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="620" height="110" as="geometry" /></mxCell>
<mxCell id="nota_conceptual" value="&lt;b&gt;Reglas de negocio representadas&lt;/b&gt;&lt;br&gt;• Un cliente tiene una o muchas mascotas; una mascota pertenece a un cliente.&lt;br&gt;• Una cita relaciona un cliente, una mascota, un veterinario y un servicio.&lt;br&gt;• Una cita atendida puede generar como máximo una factura.&lt;br&gt;• Una factura tiene una o muchas líneas; una línea puede referenciar un servicio o ser un concepto manual.&lt;br&gt;• El inventario es independiente de la facturación en esta versión." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#334155;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="900" height="100" as="geometry" /></mxCell>
<mxCell id="nota_subtipos" value="&lt;b&gt;Subtipos&lt;/b&gt;&lt;br&gt;Persona → Cliente / Empleado → Veterinario, Recepcionista, Auxiliar.&lt;br&gt;Mascota → Perro, Gato, Ave, Conejo.&lt;br&gt;Servicio → Consulta, Vacunación, Cirugía, Peluquería, Hospitalización." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#334155;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1430" y="110" width="320" height="200" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
